                nextChangeAttempt = os.clock() + 30
            end
        end
    end
end)

task.spawn(function()
    if not Config["Enable Auto Hop"] then return end
    local checkTime = math.max(1, tonumber(Config["Check Time"]) or 1800)
    local minCoin = math.max(0, tonumber(Config["Min Coin"]) or 250)
    local history = {}
    local previousCoins
    while true do
        
        -- Lưu số coin theo thời gian; nếu kiếm được dưới mức tối thiểu thì đổi server.
        local data = getPlayerData()
        local coins = tonumber(readNested(data, "Materials", "Owned", "Coins"))
        local now = os.clock()
            if coins ~= nil then
                if previousCoins and coins < previousCoins then
                    history = {}
                end
                previousCoins = coins
                table.insert(history, {time = now, coins = coins})
                local old
                for _, sample in ipairs(history) do
                    if sample.time <= now - checkTime then old = sample end
                end
                if not Autofarm_Enable and old and coins - old.coins < minCoin and not teleporting then
                    requestAutoHopTeleport()
                    return
                end

                if old then
                    for index = #history, 1, -1 do
                        if history[index].time < old.time then
                            table.remove(history, index)
                        end
                    end
                end
        end
        task.wait(math.min(120, checkTime))
    end
end)

