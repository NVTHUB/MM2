-- TỐI ƯU HIỆU NĂNG / GIẢM LAG
-- Không chỉnh sửa coin hoặc các đối tượng bên trong CoinContainer.
-- ================================
local function get_coin_container_for_optimization()
    for _, object in ipairs(Workspace:GetChildren()) do
        local container = object:FindFirstChild("CoinContainer")
        if container then
            return container
        end
    end
    return nil
end

local function optimizeObjectSafely(object)
    local coinContainer = get_coin_container_for_optimization()

    if object.Name:find("Coin")
        or (coinContainer and object:IsDescendantOf(coinContainer)) then
        return
    end

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Light")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles") then
        object.Enabled = false
        return
    end

    if object:IsA("Decal") or object:IsA("Texture") then
        object.Transparency = 1
        return
    end

    if object:IsA("BasePart") then
        if Player.Character and object:IsDescendantOf(Player.Character) then
            return
        end

        -- Giữ lại nền/sàn để nhân vật không bị rơi hoặc treo lơ lửng.
        local partName = object.Name:lower()
        local size = object.Size
        local isNamedGround = partName:find("floor")
            or partName:find("ground")
            or partName:find("base")
            or partName:find("platform")
            or partName:find("map")
        local isLargeHorizontalPart = size.X >= 35
            and size.Z >= 35
            and size.Y <= math.max(8, math.min(size.X, size.Z) * 0.25)

        if not isNamedGround and not isLargeHorizontalPart then
            object:Destroy()
        end
        return
    end
end

