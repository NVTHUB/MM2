-- Gọi cơ chế đổi folder theo mode Farmsyn hoặc FarmV5.
-- Hàm trả về thành công/thất bại để vòng lặp có thể thử lại.
local function changeFolder(folderTo, option)
    local folderFrom = Config["Folder_From"]
    local mode = tostring(Config["Change_Mode"] or "")
    if type(folderFrom) == "table" then folderFrom = folderFrom[1] end
    if type(folderTo) == "table" then folderTo = folderTo[1] end
    if mode == "Farmsyn" then
        local client = getgenv().client
        if client and type(client.ChangeToFolder) == "function" then
            return pcall(function()
                return client:ChangeToFolder(folderFrom, folderTo, false, nil)
            end)
        end
        return false, "Farmsyn client unavailable"
    elseif mode == "FarmV5" then
        local httpRequest = getRequestFunction()
        local ok, response = pcall(function()
            return httpRequest({
                Url = "https://accountops.org/api/accounts/autoswap-complete",
                Method = "POST",
                Headers = {['X-Api-Key'] = tostring(Config["ak_key"] or ""), ["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({username = Player.Name, option = option}),
            })
        end)
        return ok, response
    end
    return false, "Unknown Change_Mode"
end

