-- Chuyển mã asset trong metadata.Image thành URL ảnh dùng cho Discord webhook.
local function getDiscordImageUrl(image)
    if not image then
        return nil
    end

    local raw = tostring(image)
    local assetId = raw:match("[?&]id=(%d+)")
        or raw:match("[?&]assetId=(%d+)")
        or raw:match("rbxassetid://(%d+)")
        or raw:match("rbxthumb://.-[?&]id=(%d+)")

    if assetId then
        return "https://biggamesapi.io/image/" .. assetId
    end

    if raw:match("^https://") then
        return raw
    end

    return nil
end

-- Kiểm tra một giá trị có nằm trong danh sách cấu hình hay không.
local function listContains(list, value)
    if type(list) ~= "table" or value == nil then
        return false
    end
    for _, entry in ipairs(list) do
        if tostring(entry) ~= "" and tostring(entry):lower() == tostring(value):lower() then
            return true
        end
    end
    return false
end

-- Tạo đúng bộ tham số mở box:
-- Summer2026Box dùng SummerKey2026; các box khác dùng Coins.
local function getCrateArguments(boxName)
    if boxName == "Summer2026Box" then
        return {"Summer2026Box", "MysteryBox", "SummerKey2026"}
    end
    if boxName == "Mystery Box 2" then
        boxName = "MysteryBox2"
    end
    return {boxName, "MysteryBox", "Coins"}
end

-- Duyệt kho đồ để xác định tài khoản đã có Godly.
-- Một khi đã phát hiện Godly, cờ này giữ nguyên là true trong suốt phiên chạy.
local function updateAccountHasGodly(data)
    if accountHasGodly or type(data) ~= "table" then
        return accountHasGodly
    end
    local database = getItemDatabase()
    if not database then
        return false
    end
    for _, groupName in ipairs({"Weapons", "Radios", "Perks", "Pets", "Emotes", "Toys"}) do
        local owned = readNested(data, groupName, "Owned")
        if type(owned) == "table" then
            for itemId, amount in pairs(owned) do
                local metadata = database[itemId]
                if tonumber(amount) and tonumber(amount) > 0
                    and type(metadata) == "table"
                    and tostring(metadata.Rarity or ""):lower() == "godly" then
                    accountHasGodly = true
                    return true
                end
            end
        end
    end
    return false
end

-- Lọc item theo cấu hình rồi gửi thông tin item đạt điều kiện tới Discord webhook.
local function sendWebhookItem(itemId, boxName)
    local url = tostring(Config["Webhook URL"] or "")
    local database = getItemDatabase()
    local metadata = database and database[itemId]
    if url == "" or type(metadata) ~= "table" then
        return
    end

    local itemName = tostring(metadata.ItemName or metadata.Name or itemId)
    local webhookItemName = itemName
    if metadata.Chroma == true then
        webhookItemName = "Chroma " .. itemName
    end
    local rarity = tostring(metadata.Rarity or "Unknown")
    if rarity:lower() == "godly" then
        accountHasGodly = true
    end
    if not listContains(Config["Webhook Name Items"], itemName)
        and not listContains(Config["Webhook Name Items"], itemId)
        and not listContains(Config["Webhook Rarity Items"], rarity) then
        return
    end
    if webhookLastSent[itemId] and os.clock() - webhookLastSent[itemId] < 30 then
        return
    end
    webhookLastSent[itemId] = os.clock()

    local httpRequest = getRequestFunction()
    if not httpRequest then
        return
    end
    local embed = {
        title = "🎉  Detected: " .. webhookItemName,
        description = string.format("🔥  Rarity: **%s**\n🎁  Box: **%s**", rarity, tostring(boxName or "Unknown")),
        color = 5793266,
        footer = {text = "⚡ Username: " .. Player.DisplayName},
        timestamp = DateTime.now():ToIsoDate(),
    }

    local imageUrl = getDiscordImageUrl(metadata.Image)
    if imageUrl then
        embed.thumbnail = {
            url = imageUrl,
        }
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({username = "TANI HUB", embeds = {embed}}),
        })
    end)
    if not ok then
        warn("Webhook failed:", response)
    end
end

-- Lấy itemId từ kết quả OpenCrate và chuyển sang xử lý webhook.
local function handleCrateResult(result, boxName)
    local itemId
    if type(result) == "string" then
        itemId = result
    elseif type(result) == "table" then
        itemId = result.ItemID or result.ItemId or result.DataID or result.Name
    end
    if itemId then
        task.spawn(sendWebhookItem, tostring(itemId), boxName)
    end
end

if CrateComplete and CrateComplete:IsA("RemoteEvent") then
    -- Đây là cách nhận kết quả mở box trực tiếp từ server.
    CrateComplete.OnClientEvent:Connect(function(result)
        handleCrateResult(result, lastOpenedBox)
    end)
end

-- Mở một box, sau đó so sánh kho đồ trước và sau để tìm item mới.
local function unboxOnce(data, boxName)
    if unboxBusy then
        return false
    end
    unboxBusy = true
    local beforeData = data
    local args = getCrateArguments(boxName)
    lastOpenedBox = boxName
    local ok, result = pcall(function()
        return OpenCrate:InvokeServer(table.unpack(args))
    end)
    if not ok then
        warn("Auto Unbox failed:", result)
        unboxBusy = false
        return false
    end
    handleCrateResult(result, boxName)
    task.delay(0.5, function()
        local afterData = getPlayerData(true)
        if not afterData then
            unboxBusy = false
            return
        end
        for _, groupName in ipairs({"Weapons", "Radios", "Perks", "Pets", "Emotes", "Toys"}) do
            local beforeOwned = readNested(beforeData, groupName, "Owned") or {}
            local afterOwned = readNested(afterData, groupName, "Owned") or {}
            for itemId, amount in pairs(afterOwned) do
                if tonumber(amount) and tonumber(amount) > (tonumber(beforeOwned[itemId]) or 0) then
                    handleCrateResult(itemId, boxName)
                end
            end
        end
        updateAccountHasGodly(afterData)
        unboxBusy = false
    end)
    return true
end

