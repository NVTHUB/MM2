                local shells = tonumber(readNested(data, "Materials", "Owned", "SummerKey2026"))
                local coins = tonumber(readNested(data, "Materials", "Owned", "Coins"))
                local claimed = readNested(data, "Summer2026", "Quests", "DailyCoins", "Claimed", 6)
