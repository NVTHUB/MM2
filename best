-- Đọc một giá trị nằm sâu trong bảng dữ liệu GetData2.
local function readNested(value, ...)
    local current = value
    for _, key in ipairs({...}) do
        if type(current) ~= "table" then
            return nil
        end
        current = current[key]
    end
    return current
end

-- Lấy dữ liệu người chơi từ server.
-- Nếu lần đầu thất bại, chờ 1 giây rồi thử lại thêm một lần để tránh
-- dữ liệu lỗi bị hiểu nhầm thành 0.
local function getPlayerData(forceRefresh)
    if cachedPlayerData and not forceRefresh then
        return cachedPlayerData
    end

    if dataRequestInProgress then
        return nil
    end

    dataRequestInProgress = true
    for attempt = 1, 2 do
        local ok, data = pcall(function()
            return RemotesExtras.GetData2:InvokeServer()
        end)

        if ok and type(data) == "table" then
            cachedPlayerData = data
            dataRequestInProgress = false
            return data
        end

        if attempt == 1 then
            task.wait(1)
        end
    end

    dataRequestInProgress = false
    return nil
end

