    Coin.Text = "Coin: " .. tostring(current) .. " / " .. tostring(max)
    Status.Text = "Status: Collecting coins (" .. tostring(current) .. " / " .. tostring(max) .. ")"
    if tonumber(current) == tonumber(max) then
        Autofarm_Enable = false
        Status.Text = "Status: Maximum coins reached"
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.Health = 0
        end
        Camera.CameraType = OriginalCameraType
        Camera.CameraSubject = OriginalCameraSubject
    end
end)

-- ================================
-- AUTOFARM
-- ================================
local attemptedCoins = {}
local coinContainer
local coin
local coinTeleportDelayMin = 2.2
local coinTeleportDelayMax = 2.8

local function GetCoinContainer()
    if coinContainer and coinContainer.Parent then
        return coinContainer
    end

    coinContainer = nil
    for _, v in Workspace:GetChildren() do
        local container = v:FindFirstChild("CoinContainer")
        if container then
            coinContainer = container
            return coinContainer
        end
    end
end

local function GetCoin()
    local CoinContainer = GetCoinContainer()
    if CoinContainer then
        -- Chọn coin hợp lệ bất kỳ vì autofarm dùng teleport.
        for _, v in CoinContainer:GetChildren() do
            if v:IsA("BasePart")
                and v.Parent == CoinContainer
                and v:FindFirstChild("TouchInterest")
                and not attemptedCoins[v] then
                return v
            end
        end
    end
end

-- Tìm lại CoinContainer khi map thay đổi.
Workspace.ChildAdded:Connect(function()
    coinContainer = nil
end)

Workspace.ChildRemoved:Connect(function()
    coinContainer = nil
end)

local function SetupDescendantRemoving()
    Workspace.DescendantRemoving:Connect(function(descendant)
        if descendant == coin or descendant.Parent == coin then
            attemptedCoins[coin] = nil
            coin = nil
        end
    end)
end

local function Tick()
    local success, err = pcall(function()
        if Character and Character.PrimaryPart then
            coin = GetCoin()
            if coin then
                attemptedCoins[coin] = true

                -- Kiểm tra lại trước teleport vì coin có thể đã bị xoá.
                local currentContainer = GetCoinContainer()
                if coin.Parent ~= currentContainer
                    or not coin:IsA("BasePart")
                    or not coin:FindFirstChild("TouchInterest") then
                    attemptedCoins[coin] = nil
                    coin = nil
                    return
                end

                create_baseplat()
                local safePos = baseplatePart
                    and baseplatePart.Position + Vector3.new(0, 3, 0)
                    or Vector3.new(0, 3, 0)

                -- Tới coin trong thời gian ngắn, sau đó quay ngay về nền.
                RootPart.CFrame = coin.CFrame + Vector3.new(0, 1, 0)
                task.wait(0.35)

                if RootPart and baseplatePart and baseplatePart.Parent then
                    RootPart.CFrame = CFrame.new(safePos)
                end
                task.wait(math.random() * (coinTeleportDelayMax - coinTeleportDelayMin) + coinTeleportDelayMin)
            else
                attemptedCoins = {}
            end
        end
    end)

    if not success then
        warn("Error:", err)
    end
end

-- Worker cập nhật cache trước mỗi vòng xử lý.
task.spawn(function()
    while true do
        -- Lưu số coin ban đầu của worker.
        if FeatureCache.StartCoins == nil then
            if cachePlayerData() then
                FeatureCache.StartCoins = FeatureCache.Coins
            end
            if not FeatureCache.ItemData then
                cacheItemData()
            end
        else
            cachePlayerData()
            if not FeatureCache.ItemData then
                cacheItemData()
            end
        end

        -- Thứ tự xử lý: Auto Open -> Auto Change -> Auto Hope.
        pcall(featureAutoOpen)
        task.wait(60)

        pcall(featureAutoChange)
        task.wait(60)

        pcall(featureAutoHope)
        task.wait(60)
    end
end)

SetupDescendantRemoving()

while task.wait(0.1) do
    if Autofarm_Enable == true then
        Tick()
    end
end
