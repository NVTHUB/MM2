-- ================================
-- TỐI ƯU ĐỒ HỌA / GIẢM TẢI CPU-GPU
-- Không đụng vào nhân vật, coin hoặc CoinContainer để giữ nguyên autofarm.
-- ================================
local function getCoinContainerForOptimization()
    for _, object in ipairs(Workspace:GetChildren()) do
        local container = object:FindFirstChild("CoinContainer")
        if container then
            return container
        end
    end
    return nil
end

local function optimizeObject(object, coinContainer)
    if object.Name:find("Coin")
        or (coinContainer and object:IsDescendantOf(coinContainer)) then
        return
    end

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Light")
        or object:IsA("Fire")
        or object:IsA("Smoke")
        or object:IsA("Sparkles") then
        object.Enabled = false
        return
    end

    if object:IsA("Decal") or object:IsA("Texture") then
        object.Transparency = 1
        return
    end

    if object:IsA("BasePart") then
        if Player.Character and object:IsDescendantOf(Player.Character) then
            return
        end

        -- Chỉ giảm chất lượng hiển thị, không xoá part để giữ collision của map.
        object.Material = Enum.Material.SmoothPlastic
        object.Reflectance = 0
        object.CastShadow = false
    end
end

task.spawn(function()
    print("Info | Applying graphics optimizations")

    -- Chờ map trận đấu được nạp trước khi quét.
    task.wait(3)

    local regularLobby = Workspace:FindFirstChild("RegularLobby")
    if regularLobby then
        -- Giữ RegularLobby để không ảnh hưởng sàn và collision.
        print("Info | RegularLobby preserved")
    end

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") then
            effect.Enabled = false
        end
    end

    -- Lưu CoinContainer một lần để giảm số lần quét Workspace.
    local coinContainer = getCoinContainerForOptimization()
    for _, object in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            optimizeObject(object, coinContainer)
        end)
    end

    -- Map có thể được thay/nạp lại sau khi vào trận, nên tối ưu cả object mới.
    Workspace.DescendantAdded:Connect(function(object)
        task.defer(function()
            pcall(function()
                optimizeObject(object, getCoinContainerForOptimization())
            end)
        end)
    end)
end)

