local FeatureCache = {
    PlayerData = nil,
    ItemData = nil,
    StartCoins = nil,
    Coins = 0,
    SummerKeys = 0,
    Level = 0,
    HasGodly = false,
}

local function readNested(data, ...)
    local current = data
    for _, key in ipairs({ ... }) do
        if type(current) ~= "table" then
            return nil
        end
        current = current[key]
    end
    return current
end

local scanInventoryForGodly

local function cachePlayerData()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local extras = remotes and remotes:FindFirstChild("Extras")
    local getData = extras and extras:FindFirstChild("GetData2")
    if not getData or not getData:IsA("RemoteFunction") then
        return false
    end

    local ok, data = pcall(function()
        return getData:InvokeServer()
    end)
    if not ok or type(data) ~= "table" then
        return false
    end

    FeatureCache.PlayerData = data
    FeatureCache.Coins = tonumber(readNested(data, "Materials", "Owned", "Coins")) or 0
    FeatureCache.SummerKeys = tonumber(readNested(data, "Materials", "Owned", "SummerKey2026")) or 0
    FeatureCache.Level = tonumber(readNested(data, "Level")) or FeatureCache.Level
    if scanInventoryForGodly then
        scanInventoryForGodly(data)
    end
    return true
end

local function cacheItemData()
    local database = ReplicatedStorage:FindFirstChild("Database")
    local sync = database and database:FindFirstChild("Sync")
    local itemModule = sync and sync:FindFirstChild("Item")
    if not itemModule or not itemModule:IsA("ModuleScript") then
        FeatureCache.ItemData = nil
        return false
    end

    local ok, data = pcall(require, itemModule)
    FeatureCache.ItemData = ok and type(data) == "table" and data or nil
    if FeatureCache.ItemData and FeatureCache.PlayerData and scanInventoryForGodly then
        scanInventoryForGodly(FeatureCache.PlayerData)
    end
    return FeatureCache.ItemData ~= nil
end

local reportedGodlies = {}
local lastChangeRequest = 0
local coinHistory = {}
local previousHopeCoins
local hopeTeleporting = false

local function getRequestFunction()
    return request or http_request or (syn and syn.request)
end

local function getOwnedItems(data)
    local result = {}
    for _, groupName in ipairs({ "Weapons" }) do
        local owned = readNested(data, groupName, "Owned")
        if type(owned) == "table" then
            for itemId, amount in pairs(owned) do
                if (tonumber(amount) or 0) > 0 then
                    result[tostring(itemId)] = tonumber(amount) or 0
                end
            end
        end
    end
    return result
end

scanInventoryForGodly = function(data)
    if FeatureCache.HasGodly or type(data) ~= "table" or type(FeatureCache.ItemData) ~= "table" then
        return FeatureCache.HasGodly
    end

    for itemId, amount in pairs(getOwnedItems(data)) do
        local metadata = FeatureCache.ItemData[itemId]
        if amount > 0 and type(metadata) == "table"
            and tostring(metadata.Rarity or ""):lower() == "godly" then
            FeatureCache.HasGodly = true
            return true
        end
    end
    return false
end

local function reportGodly(itemId, boxName)
    local metadata = FeatureCache.ItemData and FeatureCache.ItemData[itemId]
    if type(metadata) ~= "table" or tostring(metadata.Rarity or ""):lower() ~= "godly" then
        return
    end

    FeatureCache.HasGodly = true
    if reportedGodlies[itemId] then
        return
    end
    reportedGodlies[itemId] = true

    local webhookUrl = tostring(Config["Webhook URL"] or "")
    local sendRequest = getRequestFunction()
    if webhookUrl == "" or not sendRequest then
        return
    end

    local itemName = tostring(metadata.ItemName or metadata.Name or itemId)
    if metadata.Chroma == true then
        itemName = "✨ Chroma " .. itemName
    end

    local rawImage = metadata.Image and tostring(metadata.Image) or ""
    local assetId = rawImage:match("[?&]id=(%d+)")
        or rawImage:match("[?&]assetId=(%d+)")
        or rawImage:match("rbxassetid://(%d+)")
        or rawImage:match("rbxthumb://.-[?&]id=(%d+)")
    local imageUrl = assetId and ("https://biggamesapi.io/image/" .. assetId)
        or (rawImage:match("^https://") and rawImage)
    local embed = {
        title = "🎉  Detected: " .. itemName,
        description = string.format("🔥  Rarity: **%s**\n🎁  Box: **%s**", tostring(metadata.Rarity or "Unknown"), tostring(boxName or "Unknown")),
        color = 5793266,
        footer = { text = "⚡  Username : " .. Player.DisplayName },
        timestamp = DateTime.now():ToIsoDate(),
    }
    if imageUrl then
        embed.thumbnail = { url = imageUrl }
    end

    pcall(function()
        sendRequest({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                username = "TANI HUB LITE",
                embeds = { embed },
            }),
        })
    end)
end

local function getOpenCrate()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local shop = remotes and remotes:FindFirstChild("Shop")
    local remote = shop and shop:FindFirstChild("OpenCrate")
    return remote and remote:IsA("RemoteFunction") and remote or nil
end

local function openOneBox(boxName, beforeOwned)
    local openCrate = getOpenCrate()
    if not openCrate then
        return false
    end

    local args
    if boxName == "Summer2026Box" then
        args = { "Summer2026Box", "MysteryBox", "SummerKey2026" }
    else
        if boxName == "Mystery Box 2" then
            boxName = "MysteryBox2"
        end
        args = { boxName, "MysteryBox", "Coins" }
    end

    local ok, result = pcall(function()
        return openCrate:InvokeServer(table.unpack(args))
    end)
    if not ok then
        warn("Auto Open failed:", result)
        return false
    end

    local itemId
    if type(result) == "string" then
        itemId = result
    elseif type(result) == "table" then
        itemId = result.ItemID or result.ItemId or result.DataID or result.Name
    end
    if itemId then
        reportGodly(tostring(itemId), boxName)
    end

    task.wait(1)
    if cachePlayerData() then
        local afterOwned = getOwnedItems(FeatureCache.PlayerData)
        for id, amount in pairs(afterOwned) do
            if amount > (beforeOwned[id] or 0) then
                reportGodly(id, boxName)
            end
        end
    end
    return true
end

local function featureAutoOpen()
    if Config["Auto Unbox"] ~= true then
        return
    end

    local selected = Config["Selected Box"]
    if type(selected) ~= "table" or #selected == 0 then
        return
    end

    while true do
        if type(FeatureCache.PlayerData) ~= "table" then
            return
        end
        if not FeatureCache.ItemData then
            cacheItemData()
        end
        local keys, coins = FeatureCache.SummerKeys, FeatureCache.Coins
        local boxName
        if table.find(selected, "Summer2026Box") and keys >= 120 then
            boxName = "Summer2026Box"
        else
            local normal = {}
            for _, name in ipairs(selected) do
                if name ~= "Summer2026Box" and tostring(name) ~= "" then
                    table.insert(normal, name)
                end
            end
            if coins < 1000 or #normal == 0 then
                return
            end
            boxName = normal[math.random(1, #normal)]
        end

        local beforeOwned = getOwnedItems(FeatureCache.PlayerData)
        if not openOneBox(boxName, beforeOwned) then
            return
        end
        task.wait(4) -- tong cong 5 giay moi box
    end
end

local function featureAutoChange()
    if Config["Auto_Change"] ~= true then
        return
    end

    -- Cập nhật dữ liệu và hồ sơ trước khi quyết định đổi tài khoản.
    if type(FeatureCache.PlayerData) ~= "table" then
        return
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local misc = remotes and remotes:FindFirstChild("Misc")
    local profileRemote = misc and misc:FindFirstChild("GetPlayerProfile")
    local level = 0
    if profileRemote and profileRemote:IsA("RemoteFunction") then
        local ok, profile = pcall(function()
            return profileRemote:InvokeServer(Player.Name)
        end)
        if ok and type(profile) == "table" then
            level = tonumber(profile.Level) or 0
        end
    end
    FeatureCache.Level = level
    if level < 10 then
        return
    end

    local option
    if FeatureCache.HasGodly then
        option = tonumber(Config["Option_Godly"])
    else
        local claimedSix = readNested(FeatureCache.PlayerData, "Summer2026", "Quests", "DailyCoins", "Claimed", 6)
        if claimedSix == nil then
            claimedSix = readNested(FeatureCache.PlayerData, "Summer2026", "Quests", "DailyCoins", "Claimed", "6")
        end
        -- Giá trị thiếu được xem là 0.
        local keys = tonumber(readNested(FeatureCache.PlayerData, "Materials", "Owned", "SummerKey2026")) or 0
        local coins = tonumber(readNested(FeatureCache.PlayerData, "Materials", "Owned", "Coins")) or 0
        if claimedSix ~= true or keys >= 120 or coins >= 900 then
            return
        end
        option = tonumber(Config["Option_Change"])
    end

    local sendRequest = getRequestFunction()
    local apiKey = tostring(Config["ak_key"] or "")
    if not sendRequest or apiKey == "" or not option then
        return
    end
    if os.clock() - lastChangeRequest < 60 then
        return
    end

    local ok, err = pcall(function()
        -- Không cần đọc response; lỗi sẽ được thử lại ở vòng sau.
        sendRequest({
            Url = "https://accountops.org/api/accounts/autoswap-complete",
            Method = "POST",
            Headers = {
                ["X-Api-Key"] = apiKey,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode({
                username = Player.Name,
                option = option,
            }),
        })
    end)
    if not ok then
        warn("Auto Change failed; will retry next loop:", err)
    else
        lastChangeRequest = os.clock()
    end
end

local function featureAutoHope()
    if Config["Enable Auto Hop"] ~= true or hopeTeleporting then
        return
    end

    if not FeatureCache.PlayerData and not cachePlayerData() then
        return
    end
    local currentCoins = tonumber(FeatureCache.Coins)
    if currentCoins == nil then
        return
    end

    local now = os.clock()
    if previousHopeCoins ~= nil and currentCoins < previousHopeCoins then
        coinHistory = {}
    end
    previousHopeCoins = currentCoins
    table.insert(coinHistory, { time = now, coins = currentCoins })

    local checkTime = math.max(1, tonumber(Config["Check Time"]) or 1800)
    local minCoin = math.max(0, tonumber(Config["Min Coin"]) or 190)
    local oldSample
    for _, sample in ipairs(coinHistory) do
        if sample.time <= now - checkTime then
            oldSample = sample
        end
    end
    if not oldSample then
        return
    end

    local earnedCoins = currentCoins - oldSample.coins
    if earnedCoins >= minCoin then
        for index = #coinHistory, 1, -1 do
            if coinHistory[index].time < oldSample.time then
                table.remove(coinHistory, index)
            end
        end
        return
    end

    hopeTeleporting = true
    Status.Text = string.format("Status: Auto hop (%d/%d coins)", earnedCoins, minCoin)
    local ok, err = pcall(function()
        TeleportService:Teleport(game.PlaceId, Player)
    end)
    if not ok then
        warn("Auto Hope teleport failed:", err)
        hopeTeleporting = false
    end
end

