local function disconnectQuestLabelConnections()
    for _, conn in ipairs(QuestLabelConnections) do
        conn:Disconnect()
    end
    table.clear(QuestLabelConnections)
end

local function findByPath(root, path)
    local current = root
    for _, name in ipairs(path) do
        if not current then
            return nil
        end
        current = current:FindFirstChild(name)
    end
    return current
end

local function parseQuestAmount(text)
    text = tostring(text or "")
    local direct = tonumber(text)
    if direct ~= nil then
        return direct
    end

    local digits = text:match("(%d+)")
    return digits and tonumber(digits) or nil
end

local function refreshQuestProgressText()
    local daily = QuestProgressData.DailyCoins
    local weekly = QuestProgressData.WeeklyQuests
    local box = QuestProgressData.Summer2026Box

    QuestProgress.Text = string.format(
        "DailyCoins | WeeklyQuests | Summer2026Box : %s | %s | %s",
        tostring(daily or "???"),
        tostring(weekly or "???"),
        tostring(box or "???")
    )
end

local function readNested(data, ...)
    local current = data
    for _, key in ipairs({ ... }) do
        if type(current) ~= "table" then
            return nil
        end
        current = current[key]
    end
    return current
end

local function applyPlayerData(data)
    if type(data) ~= "table" then
        return
    end

    local shells = readNested(data, "Materials", "Owned", "SummerKey2026")
    local daily = readNested(data, "Summer2026", "Quests", "DailyCoins", "Progress")
    local weekly = readNested(data, "Summer2026", "Quests", "WeeklyQuests", "Progress")
    local box = readNested(data, "Summer2026", "Quests", "Summer2026Box", "Progress")

    if shells ~= nil then
        Level:SetAttribute("Shells", shells)
    end
    if daily ~= nil then
        QuestProgressData.DailyCoins = daily
    end
    if weekly ~= nil then
        QuestProgressData.WeeklyQuests = weekly
    end
    if box ~= nil then
        QuestProgressData.Summer2026Box = box
    end

    refreshQuestProgressText()
end

local function getPlayerData()
    local ok, data = pcall(function()
        return RemotesExtras.GetData2:InvokeServer()
    end)
    return ok and type(data) == "table" and data or nil
end

local function getShellCount(data)
    return readNested(data, "Materials", "Owned", "Coins")
end

task.spawn(function()
    local selectedBoxes = Config["Selected Box"] or {}
    local boxIndex = 0
    local pausedUntil = 0
    local shellLimit = 120
    local coinLimit = 1000
    local pauseDuration = 10 * 60

    while true do
        task.wait(10)

        if Config["Auto Unbox"] and not Autofarm_Enable and #selectedBoxes > 0 then
            local data = getPlayerData()
            local shells = tonumber(readNested(data, "Materials", "Owned", "SummerKey2026"))
            local coins = tonumber(readNested(data, "Materials", "Owned", "Coins"))
            local now = os.clock()

            if not shells or not coins then
                continue
            elseif shells < shellLimit and coins < coinLimit then
                if now >= pausedUntil then
                    pausedUntil = now + pauseDuration
                    warn(string.format(
                        "Auto Unbox paused: Shells %d/%d, Coins %d/%d",
                        shells,
                        shellLimit,
                        coins,
                        coinLimit
                    ))
                end
            elseif now < pausedUntil then
                continue
            else
                pausedUntil = 0
                boxIndex = (boxIndex % #selectedBoxes) + 1
                local boxName = selectedBoxes[boxIndex]
                local ok, err = pcall(function()
                    OpenCrate:InvokeServer(boxName, "MysteryBox", "SummerKey2026")
                end)

                if not ok then
                    warn("Auto Unbox error:", err)
                end
            end
        end
    end
end)

task.spawn(function()
    if not Config["Enable Auto Hop"] then
        return
    end

    local checkTime = math.max(1, tonumber(Config["Check Time"]) or 1800)
    local minCoin = math.max(0, tonumber(Config["Min Coin"]) or 250)
    local sampleInterval = 120
    local coinHistory = {}

    while true do
        local currentTime = os.clock()
        local data = getPlayerData()
        local currentCoins = tonumber(getShellCount(data))

        if currentCoins ~= nil then
            table.insert(coinHistory, {
                time = currentTime,
                coins = currentCoins,
            })

            local targetTime = currentTime - checkTime
            local oldSample
            for _, sample in ipairs(coinHistory) do
                if sample.time <= targetTime then
                    oldSample = sample
                end
            end

            if oldSample then
                local earnedCoins = currentCoins - oldSample.coins
                if earnedCoins < minCoin then
                    Status.Text = string.format(
                        "Trang thai: Auto Hop (%d/%d coin trong %d phut)",
                        earnedCoins,
                        minCoin,
                        math.floor(checkTime / 60)
                    )
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, Player)
                    end)
                    return
                end

                for index = #coinHistory, 1, -1 do
                    if coinHistory[index].time < oldSample.time then
                        table.remove(coinHistory, index)
                    end
                end
            end
        end

        task.wait(sampleInterval)
    end
end)

local function bindQuestLabel(key, path)
    local obj = findByPath(PlayerGui, path)
    if not obj or not obj:IsA("TextLabel") then
        return false
    end

    QuestLabelRefs[key] = obj

    local function syncFromLabel()
        local value = parseQuestAmount(obj.Text)
        if value ~= nil then
            QuestProgressData[key] = value
            refreshQuestProgressText()
        end
    end

    syncFromLabel()
    table.insert(QuestLabelConnections, obj:GetPropertyChangedSignal("Text"):Connect(syncFromLabel))
    return true
end

local function tryBindQuestLabels()
    disconnectQuestLabelConnections()

    local foundAll = true
    for key, path in pairs(QuestLabelPaths) do
        if not bindQuestLabel(key, path) then
            foundAll = false
        end
    end

    refreshQuestProgressText()
    return foundAll
end

