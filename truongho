local function ChooseMysteryTask(pet_index, pet_unique)
    local mysteryID = "mystery"
    local petWrapper = ClientData.get("pet_char_wrappers")[pet_index]
    local ailmentData = ClientData.get_data()[game.Players.LocalPlayer.Name].ailments_manager.ailments[pet_unique][mysteryID]
    if not ailmentData then 
        print("❌ No ailment data found for mystery task.")
        return 
    end

    local startIdentity = get_thread_identity()
    setthreadidentity(2)

    local mystery = ClientData.get("ailments_manager").ailments[pet_unique].mystery
    if not (mystery and mystery.components) then
        print("⚠️ Mystery components not found.")
        setthreadidentity(startIdentity)
        return
    end

    local MysteryHelper = require(game:GetService("ReplicatedStorage").new.modules.Ailments.Helpers.MysteryHelper)
    local components = MysteryHelper.get_action(mystery)
    local seed = components.options.random_seed
    local get_ailment_slots = components.options.get_ailment_slots

    local function get_slot_categories(seedValue)
        local CloudValues = require(game:GetService("ReplicatedStorage").new.modules.LegacyLoad)("CloudValues")
        local weights = CloudValues:getValue("ailments", "mysteryAilmentCategoryWeights")
        local WeightedRandom = require(game:GetService("ReplicatedStorage").new.modules.Utilities.WeightedRandom)
        return WeightedRandom.get_values(weights, 3, seedValue)
