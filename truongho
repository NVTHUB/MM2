-- HAM SEND WEBHOOK
function SendMessageEMBED(url, embed)
    local HttpService = game:GetService("HttpService")
    local request = (syn and syn.request) or (http and http.request) or http_request

    if not request then
        warn("❌ Aucun système de requête HTTP compatible détecté.")
        return
    end

    if not url or url == "" then
        warn("❌ URL manquante dans SendMessageEMBED")
        return
    end

    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode({ embeds = {embed} })
        })
    end)

    if not success then
        warn("❌ Échec de l’envoi du webhook:", response)
    elseif type(response) == "table" and response.StatusCode and response.StatusCode >= 300 then
        warn("❌ Discord a refusé le webhook. HTTP " .. tostring(response.StatusCode) .. ": " .. tostring(response.Body or ""))
    else
        print("✅ Webhook envoyé avec succès." .. (type(response) == "table" and response.StatusCode and (" (HTTP " .. tostring(response.StatusCode) .. ")") or ""))
    end
end
