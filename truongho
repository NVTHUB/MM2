local function run_auto_potion()
    local cfg = Config.AutoPotion or {}
    if cfg.Enabled ~= true then return end
    local xpMax = {common=2500, uncommon=3600, rare=5400, ultra_rare=10700, legendary=18300}
    local potionXP = 300
    local function rarityOf(pet)
        return get_pet_rarity(pet.kind) or "common"
    end
    local selected = {}
    for _, name in ipairs(cfg.SelectedPets or {}) do
        local kind = resolveItem(name); if kind then selected[kind] = true end
    end
    local data = ClientData.get_data()[game.Players.LocalPlayer.Name]
    local pets = data.inventory.pets or {}
    local pots = {}
    for _, item in pairs(data.inventory.food or {}) do if item.kind == "pet_age_potion" then table.insert(pots, item.unique) end end
    for kind in pairs(selected) do
        local normal, neon = {}, {}
        for _, pet in pairs(pets) do
            if pet.kind == kind then
                local p = pet.properties or {}; local age = tonumber(p.age) or 0
                if p.mega_neon ~= true and p.neon == true and age < 6 then table.insert(neon, pet)
                elseif p.mega_neon ~= true and p.neon ~= true and age < 6 then table.insert(normal, pet) end
            end
        end
        local function feed(pet, needed)
            if #pots < needed then return false end
            local extra = {}
            for i=2,needed do extra[i-1] = pots[i] end
            local ok = pcall(function()
                API:WaitForChild("ToolAPI/Equip"):InvokeServer(pet.unique)
                API:WaitForChild("ToolAPI/Equip"):InvokeServer(pots[1])
                API:WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer("__Enum_PetObjectCreatorType_2", {
                    additional_consume_uniques=extra, pet_unique=pet.unique, unique_id=pots[1]})
                task.wait(.5)
                API:WaitForChild("PetAPI/ConsumeFoodObject"):FireServer(pet.unique, pots[1])
            end)
            if ok then for i=1,needed do table.remove(pots,1) end end
            return ok
        end
        if cfg.AutoPotionNeon == true then
            for _, pet in ipairs(neon) do
                local rarity = string.lower(rarityOf(pet))
                feed(pet, math.max(1, math.ceil(((xpMax[rarity] or 2500) - (pet.properties.xp or 0))/potionXP)))
            end
        end
        if cfg.CheckEnoughNeon == true then
            -- Chỉ bơm pet thường khi đủ 4 con cùng loại để tạo Neon.
            if #normal >= 4 then
                local needed = 0
                for i = 1, 4 do
                    local p = normal[i]
                    local rarity = string.lower(rarityOf(p))
                    needed += math.max(1, math.ceil(((xpMax[rarity] or 2500) - (p.properties.xp or 0)) / potionXP))
                end
                if #pots >= needed then
                    for i = 1, 4 do
                        local p = normal[i]
                        local rarity = string.lower(rarityOf(p))
                        feed(p, math.max(1, math.ceil(((xpMax[rarity] or 2500) - (p.properties.xp or 0)) / potionXP)))
                    end
                end
            end
        else
            -- Không yêu cầu đủ 4: bơm từng pet thường nếu còn đủ potion.
            for _, pet in ipairs(normal) do
                local rarity = string.lower(rarityOf(pet))
                local needed = math.max(1, math.ceil(((xpMax[rarity] or 2500) - (pet.properties.xp or 0)) / potionXP))
                if not feed(pet, needed) then
                    break
                end
            end
        end
    end
end


