local dirty_furniture, sleepy_furniture, lure_furniture, toilet_furniture, doctor_furniture
local function get_furniture_id(furniture)
	local id
	for _, v in pairs(workspace.HouseInteriors.furniture:GetChildren()) do
		local model = v:FindFirstChildWhichIsA("Model")
		if model.Name == furniture then
			id = v.Name:match("true/(.+)")
			return id
		end
	end
end

local function purchase_furniture(cframe, furniture)
	args = {
		[1] = {
			[1] = {
				["properties"] = {
					["cframe"] = cframe,
				},
				["kind"] = furniture,
			},
		},
	}
	game:GetService("ReplicatedStorage").API:FindFirstChild("HousingAPI/BuyFurnitures"):InvokeServer(unpack(args))
end
local function find_furniture_code(furniture, remote, price, cframe)
	local id = get_furniture_id(furniture)
	if id ~= nil then
		return id
	else
		local bucks = tonumber(require(game.ReplicatedStorage:WaitForChild("ClientModules").Core.ClientData).get("money"))
		if bucks >= price then
			purchase_furniture(cframe, remote)
			task.wait(5)
			local new_id = get_furniture_id(furniture)
			return new_id
		else
			print("Not enough money to purchase " .. furniture)
			return nil
		end
	end
end
