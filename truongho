local function select_farm_target()
    local cfg = getgenv().Config.PetFarm or {}
    local data = ClientData.get_data()[game.Players.LocalPlayer.Name]
    local pets = data and data.inventory and data.inventory.pets or {}
    local mode = cfg.FarmMode or "PotionFarm"
    local ignored = {}
    for _, egg in ipairs(cfg.EggToIgnoreFarm or {}) do
        local kind = resolveItem(egg)
        if kind then ignored[kind] = true end
    end

    local function age(p) return tonumber(p.properties and p.properties.age) or 0 end
    local function regular(p)
        local props = p.properties or {}
        local kind = tostring(p.kind or "")

        return kind ~= "practice_dog"
            and not kind:find("_egg$")
            and props.neon ~= true
            and props.mega_neon ~= true
    end
    local function equip(list)
        farming_pet_unique, second_farming_pet_unique = nil, nil
        if list[1] then farming_pet_unique = list[1].unique end
        if list[2] and can_equip_dual_pet then second_farming_pet_unique = list[2].unique end
        if can_equip_dual_pet then equip_dual_pet() else equip_pet() end
    end

    if mode == "EggFarm" or mode == "EggFarm2" then
        local eggs = {}
        local function refresh_eggs()
            eggs = {}
            local fresh_data = ClientData.get_data()[game.Players.LocalPlayer.Name]
            local fresh_pets = fresh_data and fresh_data.inventory and fresh_data.inventory.pets or {}
            for _, p in pairs(fresh_pets) do
                if tostring(p.kind):find("_egg$") and not ignored[p.kind] then
                    table.insert(eggs, p)
                end
            end
            return fresh_pets
        end
        refresh_eggs()
        local eggs_before = #eggs
        if #eggs < 5 and cfg.BuyEggs then
            local kind = resolveItem(cfg.EggToBuy)
            local money = tonumber(ClientData.get("money")) or 0
            local buy_count = math.max(1, 5 - #eggs)
            if kind and money > 0 then
                print("🥚 Buying " .. buy_count .. " " .. tostring(cfg.EggToBuy) .. " egg(s)...")
                local ok, err = pcall(function()
                    game.ReplicatedStorage.API["ShopAPI/BuyItem"]:InvokeServer("pets", kind, {buy_count = buy_count})
                end)
                task.wait(2)
                local fresh_pets = refresh_eggs()
                if #eggs > eggs_before then
                    print("✅ Egg purchase successful: " .. eggs_before .. " -> " .. #eggs)
                    pets = fresh_pets
                else
                    print("❌ Egg purchase failed: " .. (ok and "inventory did not increase" or tostring(err)))
                end
            end
        end
        if #eggs > 0 then
            unequip_both()
            equip(eggs)
            return
        end
        if mode == "EggFarm2" then
            mode = "CrystalEggFarm"
        else
            mode = "PotionFarm"
        end
    end

    local preferred = {}
    for _, name in ipairs(cfg.SelectedPetFarm or {}) do
        local kind = resolveItem(name)
        if kind then
            preferred[kind] = true
        else
            warn("⚠️ SelectedPetFarm item not found: " .. tostring(name))
        end
    end
    local candidates, selected = {}, {}
    for _, p in pairs(pets) do
        if regular(p) and age(p) < 6 then
            if mode == "CrystalEggFarm" then
                local count = 0
                for _, q in pairs(pets) do if regular(q) and q.kind == p.kind then count += 1 end end
                if count < 4 then continue end
            end
            table.insert(candidates, p)
            if preferred[p.kind] then table.insert(selected, p) end
        end
    end
    if mode == "PotionFarm" then
        candidates = {}
        for _, p in pairs(pets) do if regular(p) then table.insert(candidates, p) end end
        table.sort(candidates, function(a,b) return math.abs(age(a)-6) < math.abs(age(b)-6) end)
    else
        if #selected > 0 then candidates = selected end
        table.sort(candidates, function(a,b) return age(a) < age(b) end)
    end
    if #candidates > 0 then unequip_both(); equip(candidates) end
end

