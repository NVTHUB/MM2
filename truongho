    local protectedUniques = {}
    if farming_pet_unique then
        protectedUniques[tostring(farming_pet_unique)] = true
    end
    if second_farming_pet_unique then
        protectedUniques[tostring(second_farming_pet_unique)] = true
    end

    local penData = ClientData.get("idle_progression_manager") or {}
    for unique in pairs(penData.active_pets or {}) do
        protectedUniques[tostring(unique)] = true
    end

    -- Các pet trong những danh sách này được xem là pet cần giữ.
    local protectedKinds = {}
    local function addProtectedKinds(list)
        for _, petName in ipairs(list or {}) do
            local kind = resolveItem(petName)
            if kind then
                protectedKinds[kind] = true
            end
        end
    end
    addProtectedKinds((Config.PetFarm or {}).SelectedPetFarm)
    addProtectedKinds((Config.PetPen or {}).Pets)

    local function state(p)
        local props = p.properties or {}
        return props.mega_neon == true, props.neon == true, tonumber(props.age) or 0
    end

    for _, pet in pairs(inventory) do
        local petKind = tostring(pet.kind or "")
        local petUnique = tostring(pet.unique or "")
        local is2DKitty = petKind == "2d_kitty"
            or petKind == "2d_tuesdays_2025_2d_kitty"
        local isMega, isNeon, age = state(pet)
        if not protectedUniques[petUnique]
            and not protectedKinds[pet.kind]
            and not is2DKitty
            and not petKind:find("_egg$")
            and age == 6
            and not isMega then
            local category
            if cfg.MakeMega == true and isNeon then
                category = "neon"
            elseif cfg.MakeNeon == true and not isNeon then
                category = "regular"
            end
            if category then
                local key = petKind .. "|" .. category
                groups[key] = groups[key] or {}
                table.insert(groups[key], petUnique)
            end
        end
    end

    local fused = 0
    for key, ids in pairs(groups) do
        for i = 1, #ids - 3, 4 do
            local materials = {ids[i], ids[i + 1], ids[i + 2], ids[i + 3]}
            local ok, err = pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("API")
                    :WaitForChild("PetAPI/DoNeonFusion"):InvokeServer(materials)
            end)
            if ok then
                fused += 1
                print("✅ AutoNeon fusion:", key)
            else
                warn("❌ AutoNeon fusion failed:", err)
            end
            task.wait(1)
        end
    end
    return fused
end

