local function main_logic_petpen()
    if not (Config.PetPen and Config.PetPen.Enabled == true) then return end

    claim_xp()
    RemoveFullGrown_PetPen()
    RemoveDisabledPetPen()
    task.wait(2)

    local pen = ClientData.get("idle_progression_manager") or {}
    local active = pen.active_pets or {}
    local activeUniques, current = {}, 0
    for unique in pairs(active) do activeUniques[tostring(unique)] = true; current += 1 end
    local _, maxSlots = Get_Active_PetPen_Pets()
    local wanted = maxSlots - current
    if wanted <= 0 then return end

    local data = ClientData.get_data()[game.Players.LocalPlayer.Name]
    local inventory = data and data.inventory and data.inventory.pets or {}
    local ignored = {}
    for _, name in ipairs(Config.PetFarm.EggToIgnoreFarm or {}) do
        local kind = resolveItem(name)
        if kind then ignored[kind] = true end
    end
    local farmUniques = {[tostring(farming_pet_unique)] = true, [tostring(second_farming_pet_unique)] = true}
    local chosen, used = {}, {}
    local function add(p)
        local u = tostring(p.unique or "")
        if #chosen < wanted and u ~= "" and not used[u] and not activeUniques[u]
            and not farmUniques[u] and not ignored[p.kind] then
            used[u] = true; table.insert(chosen, p)
        end
    end
    local function props(p) return p.properties or {} end
    local function kindOf(p)
        local q = props(p)
        return q.mega_neon == true and "mega" or (q.neon == true and "neon" or "regular")
    end
    local function valid(p)
        return p.kind and p.unique and p.kind ~= "practice_dog"
            and p.kind ~= "2d_kitty" and p.kind ~= "2d_tuesdays_2025_2d_kitty"
            and (tonumber(props(p).age) or 0) < 6
    end
    local function addList(list, category)
        local wantedKinds = {}
        for _, name in ipairs(list or {}) do
            local k = resolveItem(name); if k then wantedKinds[k] = true end
        end
        for _, p in pairs(inventory) do
            if valid(p) and wantedKinds[p.kind] and kindOf(p) == category then add(p) end
            if #chosen >= wanted then return end
        end
    end

    -- Eggs always have priority and are filtered by EggToIgnoreFarm.
    local eggKinds = {}
    for _, name in ipairs(Config.PetPen.Eggs or {}) do
        local kind = resolveItem(name); if kind then eggKinds[kind] = true end
    end
    for _, p in pairs(inventory) do
        if #chosen >= wanted then break end
        if p.kind and eggKinds[p.kind] and tostring(p.kind):find("_egg$")
            and not ignored[p.kind] then add(p) end
    end

    local counts = {}
    for _, p in pairs(inventory) do
        if valid(p) and not tostring(p.kind):find("_egg$") then
            local category = kindOf(p)
            counts[category .. "|" .. p.kind] = (counts[category .. "|" .. p.kind] or 0) + 1
        end
    end
    if Config.PetPen.CheckEnoughNeon then
        for _, p in pairs(inventory) do
            if valid(p) and not tostring(p.kind):find("_egg$") and kindOf(p) == "regular" and counts["regular|" .. p.kind] >= 4 then add(p) end
            if #chosen >= wanted then break end
        end
    end
    if Config.PetPen.CheckEnoughMega then
        for _, p in pairs(inventory) do
            if valid(p) and not tostring(p.kind):find("_egg$") and kindOf(p) == "neon" and counts["neon|" .. p.kind] >= 4 then add(p) end
            if #chosen >= wanted then break end
        end
    end

    for _, category in ipairs(Config.PetPen.Priority or {}) do
        addList(Config.PetPen.Pets, string.lower(category))
        if #chosen >= wanted then break end
    end

    if #chosen < wanted then
        local fallback = {}
        for _, p in pairs(inventory) do if valid(p) and not tostring(p.kind):find("_egg$") then table.insert(fallback, p) end end
        table.sort(fallback, function(a,b)
            return math.abs((tonumber(props(a).age) or 0) - 6) < math.abs((tonumber(props(b).age) or 0) - 6)
        end)
        for _, p in ipairs(fallback) do add(p); if #chosen >= wanted then break end end
    end

    for _, p in ipairs(chosen) do
        print("➕ Pet Pen:", p.kind, p.unique, kindOf(p))
        game.ReplicatedStorage.API["IdleProgressionAPI/AddPet"]:FireServer(p.unique)
        task.wait()
    end
end

