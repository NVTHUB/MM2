-- LOGIC RELEASE PET
local function release_pets_by_config()
    local releaseConfig = Config.ReleasePet or {}
    if releaseConfig.Enabled ~= true then
        return
    end

    local function resolveList(list)
        local result = {}
        for _, name in ipairs(list or {}) do
            local kind = resolveItem(name)
            if kind then result[kind] = true end
        end
        return result
    end

    local regularList = resolveList(releaseConfig.RegularPetRelease)
    local neonList = resolveList(releaseConfig.NeonPetRelease)
    local megaList = resolveList(releaseConfig.MegaPetRelease)
    local playerData = ClientData.get_data()[game.Players.LocalPlayer.Name]
    local inventory = playerData and playerData.inventory and playerData.inventory.pets or {}
    local activePen = ClientData.get("idle_progression_manager") or {}
    activePen = activePen.active_pets or {}
    local penUniques = {}
    for unique in pairs(activePen) do penUniques[tostring(unique)] = true end

    local chosen, uniques = {}, {}
    for _, pet in pairs(inventory) do
        local props = pet.properties or {}
        local unique = tostring(pet.unique or "")
        local kind = pet.kind
        local isMega = props.mega_neon == true
        local isNeon = props.neon == true and not isMega
        local allowed = (isMega and megaList[kind])
            or (isNeon and neonList[kind])
            or (not isMega and not isNeon and regularList[kind])

        if unique ~= "" and kind and allowed
            and not penUniques[unique]
            and unique ~= tostring(farming_pet_unique)
            and unique ~= tostring(second_farming_pet_unique)
            and kind ~= "practice_dog"
            and kind ~= "2d_kitty"
            and kind ~= "2d_tuesdays_2025_2d_kitty"
            and not tostring(kind):find("_egg$") then
            table.insert(chosen, {kind = kind, unique = unique})
            uniques[unique] = true
            if #chosen >= 60 then break end
        end
    end

    if #chosen == 0 then
        print("ℹ️ No pets matched ReleasePet configuration.")
        return
    end

    print("♻️ Releasing " .. #chosen .. " configured pet(s)")
    game:GetService("ReplicatedStorage"):WaitForChild("API"):WaitForChild("LocationAPI/SetLocation"):FireServer("Nursery")
    task.wait(8)

    local recyclerId = getFurnitureId("pet_recycler") or "f-27"
    local ok, err = pcall(function()
        game.ReplicatedStorage.API["HousingAPI/ActivateInteriorFurniture"]:InvokeServer(
            recyclerId, "UseBlock", {uniques = uniques}, game.Players.LocalPlayer.Character
        )
    end)
    if ok then
        print("✅ Release request sent successfully.")
    else
        warn("❌ Release request failed:", err)
    end
end

